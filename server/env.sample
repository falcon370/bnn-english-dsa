PORT=5000
MONGO_URI=mongodb://localhost:27017/news_final
JWT_SECRET=supersecretjwtkey
EMBEDDING_SERVICE_URL=http://localhost:8000
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_RETRIES=3
EMBEDDING_RETRY_DELAY_MS=750
IMAGE_CSV_PATH=./BNN_image.csv
IMAGE_INGEST_BATCH_SIZE=50
IMAGE_EMBEDDING_BATCH_SIZE=16
IMAGE_INGEST_UPSERT=1
IMAGE_VECTOR_INDEX_NAME=image_embedding_vector_index
IMAGE_COLLECTION_NAME=image_metadata
IMAGE_REPOSITORY_BASE_URL=https://storage.googleapis.com/news-images-bnn/
IMAGE_REPOSITORY_VECTOR_LOOKUP=1
WIKIMEDIA_USER_AGENT=BNN-NewsImageResolver/1.0 (https://your-backend-service-url; contact: your-email@example.com)
NEWSAPI_KEY=your_newsapi_key
NEWS_API_TOKEN=your_newsapi_key
GOOGLE_API_KEY=your_google_gemini_api_key
DIAG_GEMINI=1
SERPAPI_KEY=your_serpapi_key
TRENDING_REFRESH_CRON=*/30 * * * *

